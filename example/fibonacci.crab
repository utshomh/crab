// Fibonacci: the five hundredth term, with F(0) = 0 and F(1) = 1.
// Run: cargo run -p crabi -- example/fibonacci.crab

var previous = 0
var current = 1
for i = 1 to 500 {
    var next = previous + current
    previous = current
    current = next
}
print previous 
