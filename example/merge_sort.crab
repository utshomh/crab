// Recursive merge sort. Run: cargo run -p crabi -- example/merge_sort.crab

fun mergeSort(numbers: List<Number>) -> List<Number> {
    if len(numbers) <= 1 {
        return numbers
    }

    var middle = len(numbers) / 2
    var left = [0; 0]
    var right = [0; 0]

    for i in 0..middle - 1 {
        left = push(left, numbers[i])
    }

    for i in middle..len(numbers) - 1 {
        right = push(right, numbers[i])
    }

    left = mergeSort(left)
    right = mergeSort(right)

    var result = [0; 0]
    var i = 0
    var j = 0

    while i < len(left) && j < len(right) {
        if left[i] <= right[j] {
            result = push(result, left[i])
            i = i + 1
        } else {
            result = push(result, right[j])
            j = j + 1
        }
    }

    while i < len(left) {
        result = push(result, left[i])
        i = i + 1
    }

    while j < len(right) {
        result = push(result, right[j])
        j = j + 1
    }

    return result
}

var input = [42, -3, 7, 7, 0, 1000000000000000000000000, 2]

print(mergeSort(input))
print(input) // The argument remains unchanged.
